<div class="banner text-center" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(<%= image_path('banner.jpg') %>);">
  <div class="container">
    <h1>Save your favorite movies</h1>
  </div>
</div>

<div class="m-xl">
  <h2>My Lists</h2>
  <%= link_to "Create a new list", new_list_path, class: "btn btn-primary" %>

  <% @lists.each do |list| %>
    <h3><%= link_to list.name, list_path(list) %></h3>
  <% end %>
</div>
