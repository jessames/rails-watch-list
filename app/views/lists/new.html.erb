<div class="container my-5">
  <h1 class="mb-4">Create a New List</h1>

  <%= simple_form_for @list do |f| %>
    <%= f.input :name,label: "List Name", placeholder: "e.g. My Favorite Movies" %>

    <%= f.input :photo, as: :file, label: "Cover Image" %>

    <%= f.submit "Create List", class: "btn btn-success mt-2" %>
  <% end %>

  <%= link_to "Back to all lists", lists_path, class: "btn btn-secondary mt-4" %>
</div>
