<div class="container my-5">
  <h1><%= @list.name %></h1>

  <%= link_to "Add a movie",
      new_list_bookmark_path(@list),
      class: "btn btn-success my-3" %>

  <div class="row g-4">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-12 col-md-4">
        <div class="card h-100">
          <%= image_tag bookmark.movie.poster_url,
              class: "card-img-top" %>

          <div class="card-body">
            <h5 class="card-title">
              <%= bookmark.movie.title %>
            </h5>

            <p class="card-text">
              <%= bookmark.comment %>
            </p>

            <%= link_to "Remove",
                bookmark_path(bookmark), data: { turbo_method: :delete }, class: "btn btn-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to all lists", lists_path, class: "btn btn-secondary mt-4" %>
</div>
