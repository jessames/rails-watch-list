<div class="container my-5">
  <h1>Add a movie to <%= @list.name %></h1>

  <%= simple_form_for [@list, @bookmark] do |f| %>
    <%= f.association :movie, collection: Movie.all %>
    <%= f.input :comment %>
    <%= f.submit "Add Movie", class: "btn btn-success" %>
  <% end %>

 <%= link_to "Back to all lists", lists_path, class: "btn btn-secondary mt-4" %>
</div>
